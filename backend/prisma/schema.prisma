
//Schema local
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int             @id @default(autoincrement())
  firstName           String?
  lastName            String?
  role                Role            @default(USER)
  balance             Decimal         @default(0.00) @db.Decimal(10, 2)
  subscriptionEndDate DateTime?       @map("subscription_end_date")
  sessionCount        Int?            @map("session_count")
  dateOfBirth         DateTime?       @map("date_of_birth") @db.Date
  postalCode          String?         @map("postal_code") @db.VarChar(20)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  cashMovements       CashMovement[]
  closedCashRegisters CashRegister[]  @relation("ClosedBy")
  openedCashRegisters CashRegister[]  @relation("OpenedBy")
  orders              Order[]
  standbyOrders       StandbyOrder[]
  dailyPresences      DailyPresence[]
  payments            Payment[]

  @@map("users")
}

model SubscriptionDuration {
  id       Int     @id @default(autoincrement())
  duration Int
  label    String  @db.VarChar(50)
  price    Decimal @db.Decimal(10, 2)

  @@map("subscription_durations")
}

model SessionPassPrice {
  id       Int     @id @default(autoincrement())
  sessions Int
  label    String  @db.VarChar(50)
  price    Decimal @db.Decimal(10, 2)

  @@map("session_pass_prices")
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  quantity       Int              @default(0)
  price          Decimal          @db.Decimal(10, 2)
  trainerPrice   Decimal          @map("trainer_price") @db.Decimal(10, 2)
  cost           Decimal?         @default(0.00) @db.Decimal(10, 2)
  isActive       Boolean          @default(true)
  hasDailyStock  Boolean          @default(false) @map("has_daily_stock")
  displayOrder   Int              @default(0) @map("display_order")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  orderDetails   OrderDetail[]
  dailyStocks    DailyStock[]
  stockAdditions StockAddition[]

  @@map("products")
}

model Order {
  id              Int            @id @default(autoincrement())
  clientId        Int
  totalAmount     Decimal        @map("total_amount") @db.Decimal(10, 2)
  date            DateTime       @default(now())
  paymentMethod   PaymentType    @map("payment_method")
  notes           String?
  discount        Float?         @default(0)
  trou            Decimal?       @db.Decimal(10, 2)
  useTrainerPrice Boolean        @default(false) @map("use_trainer_price")  // Appliquer le prix entraîneur
  cashMovements   CashMovement[]
  products        OrderDetail[]
  client          User           @relation(fields: [clientId], references: [id])

  @@index([clientId], map: "orders_clientId_fkey")
  @@map("orders")
}

model OrderDetail {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "order_details_orderId_fkey")
  @@index([productId], map: "order_details_productId_fkey")
  @@map("order_details")
}

model CashRegister {
  id              Int                @id @default(autoincrement())
  openingDate     DateTime           @default(now()) @map("opening_date")
  closingDate     DateTime?          @map("closing_date")
  openingBalance  Decimal            @default(0.00) @map("opening_balance") @db.Decimal(10, 2)
  closingBalance  Decimal?           @map("closing_balance") @db.Decimal(10, 2)
  expectedBalance Decimal?           @map("expected_balance") @db.Decimal(10, 2)
  difference      Decimal?           @db.Decimal(10, 2)
  status          CashRegisterStatus @default(OPEN)
  notes           String?
  openedBy        Int?               @map("opened_by")
  closedBy        Int?               @map("closed_by")
  movements       CashMovement[]
  closedByUser    User?              @relation("ClosedBy", fields: [closedBy], references: [id])
  openedByUser    User?              @relation("OpenedBy", fields: [openedBy], references: [id])

  @@index([closedBy], map: "cash_register_closed_by_fkey")
  @@index([openedBy], map: "cash_register_opened_by_fkey")
  @@map("cash_register")
}

model CashMovement {
  id             Int          @id @default(autoincrement())
  cashRegisterId Int          @map("cash_register_id")
  movementType   MovementType @map("movement_type")
  amount         Decimal      @db.Decimal(10, 2)
  orderId        Int?         @map("order_id")
  description    String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      Int?         @map("created_by")
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [createdBy], references: [id])
  order          Order?       @relation(fields: [orderId], references: [id])

  @@index([cashRegisterId], map: "cash_movements_cash_register_id_fkey")
  @@index([createdBy], map: "cash_movements_created_by_fkey")
  @@index([orderId], map: "cash_movements_order_id_fkey")
  @@map("cash_movements")
}

model DailyReport {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique @db.Date
  startingCash     Decimal  @default(0) @db.Decimal(10, 2) @map("starting_cash")    // Fond de caisse de début = Fond de fin du jour précédent
  cashRevenue      Decimal  @default(0) @db.Decimal(10, 2) @map("cash_revenue")     // Espèces du jour
  qrRevenue        Decimal  @default(0) @db.Decimal(10, 2) @map("qr_revenue")       // QR Code du jour
  creditRevenue    Decimal  @default(0) @db.Decimal(10, 2) @map("credit_revenue")   // Crédit du jour
  trou             Decimal  @default(0) @db.Decimal(10, 2)                           // Le Trou (valeur manuelle)
  retrait          Decimal  @default(0) @db.Decimal(10, 2)                           // Retrait de caisse (valeur manuelle, négatif)
  endingCash       Decimal  @default(0) @db.Decimal(10, 2) @map("ending_cash")      // Fond de caisse de fin = startingCash + cashRevenue + trou + retrait
  notes            String?
  closedBy         Int?     @map("closed_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("daily_reports")
}

model StandbyOrder {
  id              Int          @id @default(autoincrement())
  userId          Int?         @map("user_id")
  paymentMethod   PaymentType? @map("payment_method")
  notes           String?      @db.Text
  discountValue   Float        @default(0) @map("discount_value")
  discountComment String?      @map("discount_comment") @db.Text
  cartData        String       @map("cart_data") @db.Text  // JSON string du panier
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "standby_orders_userId_fkey")
  @@map("standby_orders")
}

model DailyStock {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  quantity   Int      @default(0)
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId], map: "daily_stock_productId_fkey")
  @@index([date], map: "daily_stock_date_idx")
  @@map("daily_stock")
}

model StockAddition {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  quantity     Int
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "stock_addition_productId_fkey")
  @@index([date], map: "stock_addition_date_idx")
  @@map("stock_additions")
}

model DailyPresence {
  id        Int      @id @default(autoincrement())
  memberId  Int      @map("member_id")
  member    User     @relation(fields: [memberId], references: [id])
  arrivedAt DateTime @default(now()) @map("arrived_at")

  @@index([memberId], map: "daily_presence_memberId_fkey")
  @@index([arrivedAt], map: "daily_presence_arrivedAt_idx")
  @@map("daily_presences")
}

enum Role {
  TRAINER
  USER
}

enum PaymentType {
  CREDITCARD
  PAYPAL
  CASH
  QRCODE
  ACCOUNT_DEBIT
  FREE
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum MovementType {
  OPENING_FUND
  SALE
  REFUND
  EXPENSE
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

model Payment {
  id          Int         @id @default(autoincrement())
  memberId    Int         @map("member_id")
  type        MemberPaymentType
  period      String      @db.VarChar(100)
  paymentMode MemberPaymentMode @default(CASH) @map("payment_mode")
  price       Decimal?    @db.Decimal(10, 2)
  comment     String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  member      User        @relation(fields: [memberId], references: [id])

  @@index([memberId], map: "payments_memberId_fkey")
  @@index([createdAt], map: "payments_createdAt_idx")
  @@map("payments")
}

enum MemberPaymentType {
  FORFAIT
  ENTREE
}

enum MemberPaymentMode {
  CASH
  QRCODE
}
